# 依赖与运行时产物
node_modules/
__pycache__/
*.pyc
.DS_Store
outputs/

# 本机私有配置（含 API Key，严禁提交）
configs/settings.json
configs/schedules.json
configs/learned/
configs/_adaptive_strategies.json
configs/auto_precise_*.json*

# 登录态 / Cookie（0600 私密）
*.session
*.session.json
*.cookie.txt
.cookie.txt
jobs_history.json

# 运行时/本地产物（hy4 反馈 P2：仓库体积与垃圾目录）
# 注意：.gitignore 不支持行内注释，注释必须独占一行
# tasks/ 为运行时生成的任务包（历史上有 4 个文件已被提交，不回删）
tasks/
# plugins/ 是用户自放钩子的位置——提交进去会让所有人被意外改数据
plugins/
# fixtures/ 为本地夹具测试数据（scripts/fixture_test.py 缺目录时自动跳过）
fixtures/
report.html
r.html
dl_out/
downloads/
.hypothesis/
.pytest_cache/
*.corrupt
*.part[0-9]*
*.manifest.json
