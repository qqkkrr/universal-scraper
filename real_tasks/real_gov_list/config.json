{
  "name": "real_gov_list",
  "start_urls": [
    "https://www.gov.cn/zhengce/"
  ],
  "queue": {
    "max_depth": 1,
    "max_requests": 8,
    "max_concurrency": 1
  },
  "source": {
    "type": "browser",
    "pool": true,
    "stealth": true,
    "wait_selector": "li"
  },
  "rules": [
    {
      "match": "contains",
      "pattern": "/zhengce",
      "parser": "js"
    }
  ],
  "parsers": {
    "js": {
      "type": "html",
      "row_css": "li.poster-item",
      "fields": {
        "title": {
          "css": ".picTitle a"
        },
        "url": {
          "css": ".picTitle a",
          "attr": "href"
        }
      }
    }
  },
  "pipelines": [
    {
      "type": "filter",
      "field": "title",
      "op": "non_empty"
    }
  ],
  "storage": {
    "type": "jsonl",
    "name": "real_gov_list"
  },
  "output": {
    "dir": "outputs",
    "base_name": "real_gov_list"
  },
  "anti_bot": {
    "min_interval": 0.5,
    "max_retries": 1
  }
}