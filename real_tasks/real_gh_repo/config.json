{
  "name": "real_gh_repo",
  "start_urls": [
    "https://api.github.com/repos/openai/codex"
  ],
  "queue": {
    "max_depth": 1,
    "max_requests": 5,
    "max_concurrency": 1
  },
  "source": {
    "type": "http"
  },
  "rules": [
    {
      "match": "contains",
      "pattern": "/",
      "parser": "js"
    }
  ],
  "parsers": {
    "js": {
      "type": "json",
      "fields": {
        "title": {
          "from": "full_name"
        },
        "desc": {
          "from": "description"
        },
        "stars": {
          "from": "stargazers_count"
        }
      }
    }
  },
  "pipelines": [
    {
      "type": "filter",
      "field": "title",
      "op": "non_empty"
    }
  ],
  "storage": {
    "type": "jsonl",
    "name": "real_gh_repo"
  },
  "output": {
    "dir": "outputs",
    "base_name": "real_gh_repo"
  },
  "anti_bot": {
    "min_interval": 0.3,
    "max_retries": 2,
    "headers": {
      "Accept": "application/vnd.github+json"
    }
  }
}