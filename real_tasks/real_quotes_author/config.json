{
  "name": "real_quotes_author",
  "start_urls": [
    "https://quotes.toscrape.com/author/Albert-Einstein/"
  ],
  "queue": {
    "max_depth": 1,
    "max_requests": 30,
    "max_concurrency": 2
  },
  "source": {
    "type": "http"
  },
  "rules": [
    {
      "match": "contains",
      "pattern": "/",
      "parser": "js"
    }
  ],
  "parsers": {
    "js": {
      "type": "html",
      "fields": {
        "title": {
          "css": "h3.author-title"
        },
        "born": {
          "css": "span.author-born-date"
        },
        "desc": {
          "css": "div.author-description",
          "limit": 1000
        }
      }
    }
  },
  "pipelines": [
    {
      "type": "filter",
      "field": "title",
      "op": "non_empty"
    }
  ],
  "storage": {
    "type": "jsonl",
    "name": "real_quotes_author"
  },
  "output": {
    "dir": "outputs",
    "base_name": "real_quotes_author"
  },
  "anti_bot": {
    "min_interval": 0.3,
    "max_retries": 2
  }
}