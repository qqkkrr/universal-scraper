{
  "name": "real_gov_article",
  "start_urls": [
    "https://www.gov.cn/zhengce/jiedu/tujie/202608/content_7077564.htm"
  ],
  "queue": {
    "max_depth": 1,
    "max_requests": 5,
    "max_concurrency": 1
  },
  "source": {
    "type": "browser",
    "pool": true,
    "stealth": true
  },
  "rules": [
    {
      "match": "contains",
      "pattern": "/zhengce",
      "parser": "js"
    }
  ],
  "parsers": {
    "js": {
      "type": "html",
      "fields": {
        "title": {
          "css": "h1",
          "limit": 300
        },
        "body": {
          "css": "div#UCAP-CONTENT, .pages_content, .article",
          "limit": 5000
        }
      }
    }
  },
  "pipelines": [
    {
      "type": "filter",
      "field": "title",
      "op": "non_empty"
    }
  ],
  "storage": {
    "type": "jsonl",
    "name": "real_gov_article"
  },
  "output": {
    "dir": "outputs",
    "base_name": "real_gov_article"
  },
  "anti_bot": {
    "min_interval": 0.5,
    "max_retries": 1
  }
}