{
  "name": "real_quotes_list",
  "start_urls": [
    "https://quotes.toscrape.com/"
  ],
  "queue": {
    "max_depth": 3,
    "max_requests": 12,
    "max_concurrency": 2
  },
  "source": {
    "type": "http"
  },
  "rules": [
    {
      "match": "contains",
      "pattern": "/",
      "parser": "js"
    }
  ],
  "parsers": {
    "js": {
      "type": "html",
      "row_css": ".quote",
      "fields": {
        "title": {
          "css": "span.text",
          "limit": 300
        },
        "author": {
          "css": "small.author"
        },
        "tags": {
          "css": "a.tag",
          "limit": 200
        }
      },
      "extract_links": {
        "allow": "/page/\\d+",
        "same_domain": true
      }
    }
  },
  "pipelines": [
    {
      "type": "filter",
      "field": "title",
      "op": "non_empty"
    }
  ],
  "storage": {
    "type": "jsonl",
    "name": "real_quotes_list"
  },
  "output": {
    "dir": "outputs",
    "base_name": "real_quotes_list"
  },
  "anti_bot": {
    "min_interval": 0.3,
    "max_retries": 2
  }
}