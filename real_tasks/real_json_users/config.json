{
  "name": "real_json_users",
  "start_urls": [
    "https://jsonplaceholder.typicode.com/users"
  ],
  "queue": {
    "max_depth": 1,
    "max_requests": 5,
    "max_concurrency": 2
  },
  "source": {
    "type": "http"
  },
  "rules": [
    {
      "match": "contains",
      "pattern": "/",
      "parser": "js"
    }
  ],
  "parsers": {
    "js": {
      "type": "json",
      "fields": {
        "title": {
          "from": "name"
        },
        "email": {
          "from": "email"
        }
      }
    }
  },
  "pipelines": [
    {
      "type": "filter",
      "field": "title",
      "op": "non_empty"
    }
  ],
  "storage": {
    "type": "jsonl",
    "name": "real_json_users"
  },
  "output": {
    "dir": "outputs",
    "base_name": "real_json_users"
  },
  "anti_bot": {
    "min_interval": 0.3,
    "max_retries": 2
  }
}