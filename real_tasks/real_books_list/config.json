{
  "name": "real_books_list",
  "start_urls": [
    "https://books.toscrape.com/"
  ],
  "queue": {
    "max_depth": 3,
    "max_requests": 12,
    "max_concurrency": 2
  },
  "source": {
    "type": "http"
  },
  "rules": [
    {
      "match": "contains",
      "pattern": "/",
      "parser": "js"
    }
  ],
  "parsers": {
    "js": {
      "type": "html",
      "row_css": "article.product_pod",
      "fields": {
        "title": {
          "css": "h3 a",
          "attr": "title"
        },
        "price": {
          "css": "p.price_color"
        },
        "url": {
          "css": "h3 a",
          "attr": "href"
        }
      },
      "extract_links": {
        "allow": "/catalogue/page-\\d+\\.html",
        "same_domain": true
      }
    }
  },
  "pipelines": [
    {
      "type": "filter",
      "field": "title",
      "op": "non_empty"
    }
  ],
  "storage": {
    "type": "jsonl",
    "name": "real_books_list"
  },
  "output": {
    "dir": "outputs",
    "base_name": "real_books_list"
  },
  "anti_bot": {
    "min_interval": 0.3,
    "max_retries": 2
  }
}