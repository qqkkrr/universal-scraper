     },
     "link": {
      "css": "h5.feed-block-title a::attr(href)"
     },
     "buy_link": {
      "css": "xpath:.//a[contains(concat(' ', normalize-space(@class), ' '), ' buy ') or contains(@class,'go-buy') or contains(@class,'z-buy')][1]/@href"
     },
     "discount_desc": {
      "css": ".feed-block-descripe::text"
     },
     "tag_check": {
      "css": "xpath:.//a[contains(normalize-space(.),'手慢无')]/text() | .//span[contains(normalize-space(.),'手慢无')]/text()"
     }
    },
    "extract_links": {
     "allow": "^/jianlou/p\\d+/$",
     "same_domain": true
    }
   },
   "default": {
    "type": "html",
    "row_css": "li.feed-row",
    "fields": {
     "title": {
      "css": "h5.feed-block-title a::text"
     },
     "link": {
      "css": "h5.feed-block-title a::attr(href)"
     },
     "buy_link": {
      "css": "xpath:.//a[contains(concat(' ', normalize-space(@class), ' '), ' buy ') or contains(@class,'go-buy') or contains(@class,'z-buy')][1]/@href"
     },
     "discount_desc": {
      "css": ".feed-block-descripe::text"
     },
     "tag_check": {
      "css": "xpath:.//a[contains(normalize-space(.),'手慢无')]/text() | .//span[contains(normalize-space(.),'手慢无')]/text()"
     }
    },
    "extract_links": {
     "allow": "^/jianlou/p\\d+/$",
     "same_domain": true
    }
   }
  },
  "pipelines": [
   {
    "type": "filter",
    "field": "tag_check",
    "op": "non_empty"
   },
   {
    "type": "filter",
    "field": "link",
    "op": "non_empty"
   },
   {
    "type": "dedup",
    "key": "link"
   }
  ],
  "detail": {
   "enabled": true,
   "url_field": "link",
   "url_transform": [
