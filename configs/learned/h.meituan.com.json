  ],
  "source": {
   "type": "browser",
   "scroll_count": 8,
   "scroll_wait_ms": 800,
   "record_from": "capture_all",
   "capture_all": true
  },
  "rules": [
   {
    "match": "contains",
    "pattern": "/s/",
    "parser": "list"
   }
  ],
  "parsers": {
   "list": {
    "type": "html",
    "row_css": ".poi-item, .poi-list > div, .shop-list li, .list-item, ul.shops-list > li, .search-result-poi-item",
    "fields": {
     "title": {
      "css": ".title::text, .poi-name::text, .name::text, .shop-name::text, a:first-of-type::text"
     },
     "score": {
      "css": ".score::text, .star-score::text, .rating::text, .num::text"
     },
     "avg_price": {
      "css": ".avg-price::text, .price::text, .per-price::text, .cost::text"
     },
     "link": {
      "css": "a.title::attr(href), .title a::attr(href), a:first-of-type::attr(href)"
     }
    },
    "extract_links": {
     "allow": "/(s|search)/",
     "same_domain": true
    }
   },
   "default": {
    "type": "html",
    "row_css": ".poi-item, .poi-list > div, .shop-list li, .list-item, ul.shops-list > li, .search-result-poi-item",
    "fields": {
     "title": {
      "css": ".title::text, .poi-name::text, .name::text, .shop-name::text, a:first-of-type::text"
     },
     "score": {
      "css": ".score::text, .star-score::text, .rating::text, .num::text"
     },
     "avg_price": {
      "css": ".avg-price::text, .price::text, .per-price::text, .cost::text"
     },
     "link": {
      "css": "a.title::attr(href), .title a::attr(href), a:first-of-type::attr(href)"
     }
    },
    "extract_links": {
     "allow": "/(s|search)/",
     "same_domain": true
    }
   }
  },
  "pipelines": [
   {
    "type": "filter",
    "field": "title",
    "op": "non_empty"
   },
   {
    "type": "filter",
    "field": "link",
    "op": "non_empty"
   },
   {
    "type": "dedup",
    "key": "link"
   }
  ],
  "detail": {
   "enabled": true,
   "url_field": "link",
   "url_transform": [
