     },
     "price": {
      "from": "salePrice"
     },
     "tax": {
      "from": "taxFee"
     },
     "rating": {
      "from": "averageScore"
     }
    }
   },
   "default": {
    "type": "json_paged",
    "records_path": "data.list",
    "strategy": "page_param",
    "page_param": "pageNumber",
    "page_size_param": "pageSize",
    "page_size": 20,
    "max_pages": 1,
    "fields": {
     "product_name": {
      "from": "title"
     },
     "price": {
      "from": "salePrice"
     },
     "tax": {
      "from": "taxFee"
     },
     "rating": {
      "from": "averageScore"
     }
    }
   }
  },
